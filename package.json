{
  "name": "@brucecheung666/dsh-subagent-panel",
  "version": "0.1.3",
  "description": "DeepSeek Harness 插件：对话区左侧可收起的子 Agent 面板，只整合当前会话的 subagent 谱系（根会话/自己/子 agent）。",
  "type": "module",
  "license": "MIT",
  "author": "BruceCheung666",
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "homepage": "https://github.com/BruceCheung666/dsh-subagent-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceCheung666/dsh-subagent-panel.git"
  },
  "bugs": {
    "url": "https://github.com/BruceCheung666/dsh-subagent-panel/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "session",
    "panel"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
